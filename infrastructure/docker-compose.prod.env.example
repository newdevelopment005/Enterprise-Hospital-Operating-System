# Template for the production Docker Compose deployment.
# Copy to .env.prod next to infrastructure/docker-compose.prod.yml and fill
# REAL secrets. NEVER commit the real file. Use k8s Secrets when running Helm.

EHOS_ENV=production
EHOS_PUBLIC_HOST=hospital.example.org

# PostgreSQL
POSTGRES_USER=ehos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO
MINIO_ROOT_USER=ehos
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# AI
AI_INFERENCE_ADAPTER=vllm
AI_EMBEDDING_ADAPTER=ollama
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
HF_HOME=/var/lib/huggingface
PREDICTION_DEFAULT_ADAPTER=seasonal_naive

# Registry used by service images (when not building locally)
REGISTRY=ghcr.io/your-org/ehos
TAG=latest

# Backup off-site target (optional; 3-2-1 rule)
BACKUP_TARGET_S3_ENDPOINT=https://backup-server.internal
BACKUP_TARGET_ACCESS_KEY=CHANGE_ME
BACKUP_TARGET_SECRET_KEY=CHANGE_ME
BACKUP_TARGET_BUCKET=ehos-backups