# ============================================================
# EHOS - Enterprise Hospital Operating System
# Environment template. Copy to .env and fill real values.
# NEVER commit the real .env file.
# ============================================================

# ---- Platform ----
EHOS_ENV=development
EHOS_LOG_LEVEL=INFO

# ---- PostgreSQL (one database per service) ----
POSTGRES_USER=ehos
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- MinIO ----
MINIO_ROOT_USER=ehos
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_ENDPOINT=http://minio:9000

# ---- Keycloak / Identity ----
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ehos
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production
KEYCLOAK_CLIENT_ID=ehos-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ---- API Gateway ----
GATEWAY_PORT=8000

# ---- Service ports (development) ----
CONFIGURATION_SERVICE_PORT=8100
AUDIT_SERVICE_PORT=8200
NOTIFICATION_SERVICE_PORT=8300
IDENTITY_SERVICE_PORT=8400
