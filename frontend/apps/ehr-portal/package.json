{
  "name": "ehr-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EHOS Clinical EHR portal: patient chart with SOAP/progress/discharge notes, vitals, diagnoses, medications, orders, allergies, problem list, medical history and clinical timeline.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}