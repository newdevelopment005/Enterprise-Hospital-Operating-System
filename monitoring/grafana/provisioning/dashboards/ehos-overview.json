{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "EHOS service availability",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 * avg_over_time(up{namespace=~\"ehos-.*\"}[5m])", "format": "time_series", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["mean"], "values": false }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Container restarts in 1h",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"ehos-.*\"}[1h]))", "refId": "A" }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Active alerts",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(ALERTS{alertstate=\"firing\"})", "refId": "A" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (group) (kafka_consumergroup_lag)", "legendFormat": "{{ group }}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 5,
      "title": "HTTP request rate (per service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (job) (rate(http_requests_total{namespace=~\"ehos-.*\"}[5m]))", "legendFormat": "{{ job }}", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 6,
      "title": "GPU utilisation (inference)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "max(DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "GPU util %", "refId": "A" }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["maxNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 12 }
    },
    {
      "id": 7,
      "title": "Postgres active connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (datname) (pg_stat_database_numbackends)", "legendFormat": "{{ datname }}", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ehos", "hospital"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "EHOS Executive Overview",
  "uid": "ehos-overview",
  "version": 1
}